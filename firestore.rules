rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(ranchId) {
      return /databases/$(database)/documents/ranches/$(ranchId)/members/$(request.auth.uid);
    }

    function isMember(ranchId) {
      return signedIn()
        && exists(memberPath(ranchId))
        && get(memberPath(ranchId)).data.get('active', true) != false
        && get(memberPath(ranchId)).data.get('status', 'active') == 'active';
    }

    function memberRole(ranchId) {
      return isMember(ranchId)
        ? get(memberPath(ranchId)).data.role
        : 'None';
    }

    function isAdmin(ranchId) {
      return memberRole(ranchId) == 'Admin';
    }

    // The VIMO Team: added only from the Firebase console.
    function isVimoTeam() {
      return signedIn() && exists(/databases/$(database)/documents/vimo_admins/$(request.auth.uid));
    }

    // The team can stop an account from buying and selling in Market.
    function marketBlocked() {
      let path = /databases/$(database)/documents/vimo_sanctions/$(request.auth.uid);
      return exists(path) && get(path).data.market == 'blocked';
    }

    // The team reads a conversation or an order only after one of the two
    // people reports it.
    function reportedChat(chat) {
      return isVimoTeam() && exists(/databases/$(database)/documents/vimo_reported_chats/$(chat));
    }
    function reportedOrder(order) {
      return isVimoTeam() && exists(/databases/$(database)/documents/vimo_reported_orders/$(order));
    }

    function canEditAnimals(ranchId) {
      return memberRole(ranchId) in ['Admin', 'Editor'];
    }

    function canUpdateAnimalEntry(ranchId) {
      return canRecordEntries(ranchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pregnancyStartDate',
          'pregnancyInjection',
          'milkingStopDate',
          'workLog',
          'cloudId',
          'deviceKey',
          'updatedAtMillis',
          'updatedAtText',
          'updatedBy'
        ]);
    }

    function canRecordEntries(ranchId) {
      // Data Entry is the current limited-entry role. The two legacy names are
      // temporarily accepted so existing approved family members keep working
      // until their membership document is migrated by the admin.
      return memberRole(ranchId) in ['Admin', 'Editor', 'Data Entry', 'Basic Entry', 'Viewer'];
    }

    function canWriteSale(ranchId) {
      return canEditAnimals(ranchId)
        || (
          canRecordEntries(ranchId)
          && request.resource.data.type in ['Milk', 'Manure']
        );
    }

    function validUsernameChange() {
      let data = request.resource.data;
      return (resource == null && !('username' in data) && !('usernameChangedAt' in data))
        || (resource != null && !data.diff(resource.data).affectedKeys().hasAny(['username', 'usernameChangedAt']))
        || (data.username is string && data.username.matches('^[a-z][a-z0-9_]{2,19}$')
          && data.usernameChangedAt == request.time
          && (resource == null || !('usernameChangedAt' in resource.data) || request.time >= resource.data.usernameChangedAt + duration.value(30, 'd'))
          && getAfter(/databases/$(database)/documents/usernames/$(data.username)).data.uid == request.auth.uid);
    }
    match /usernames/{name} {
      // Sign-up checks that a VIMO ID is free before the account exists, so a
      // single name can be looked up signed out. Listing all names is denied.
      allow get: if true;
      allow list: if false;
      // One namespace for VIMO IDs: a name already used as a Ranch ID
      // cannot become a username.
      allow create: if signedIn() && name.matches('^[a-z][a-z0-9_]{2,19}$')
        && !exists(/databases/$(database)/documents/ranch_ids/$(name))
        && request.resource.data.keys().hasOnly(['uid', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.claimedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameChangedAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != name
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameChangedAt == request.time;
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && validUsernameChange();
      allow delete: if false;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'photo', 'bio', 'bioMentions', 'link', 'updatedAt', 'displayName', 'displayNameFold', 'place', 'whatsapp', 'shareRanch', 'ranchId', 'ranchName', 'ranchLayout', 'shareShop', 'shopName', 'shopDetails'])
        && request.resource.data.username == getAfter(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.get('photo', '') is string
        && request.resource.data.get('photo', '').size() <= 600000
        && (request.resource.data.get('photo', '') == '' || request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.get('bio', '') is string && request.resource.data.get('bio', '').size() <= 160
        && request.resource.data.get('bioMentions', []) is list && request.resource.data.get('bioMentions', []).size() <= 12
        && request.resource.data.get('link', '') is string && request.resource.data.get('link', '').size() <= 300
        && (request.resource.data.get('link', '') == '' || request.resource.data.link.matches('^https?://[^ /@]+[.][^ /@]+.*$'))
        && request.resource.data.get('displayName', '') is string && request.resource.data.get('displayName', '').size() <= 80
        && request.resource.data.get('displayNameFold', '') is string && request.resource.data.get('displayNameFold', '').size() <= 160
        && request.resource.data.get('place', '') is string && request.resource.data.get('place', '').size() <= 120
        && request.resource.data.get('whatsapp', '') is string && (request.resource.data.get('whatsapp', '') == '' || request.resource.data.whatsapp.matches('^[+]?[0-9]{7,15}$'))
        && request.resource.data.get('shareRanch', false) is bool
        && request.resource.data.get('ranchName', '') is string && request.resource.data.get('ranchName', '').size() <= 160
        && request.resource.data.get('ranchLayout', 'grid') in ['grid', 'list']
        && (request.resource.data.get('shareRanch', false) == false || isMember(request.resource.data.ranchId))
        && request.resource.data.get('shareShop', false) is bool
        && request.resource.data.get('shopName', '') is string && request.resource.data.get('shopName', '').size() <= 100
        && request.resource.data.get('shopDetails', '') is string && request.resource.data.get('shopDetails', '').size() <= 500
        && request.resource.data.updatedAt == request.time;
      match /contacts/{peer} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && peer != uid
          && exists(/databases/$(database)/documents/profiles/$(peer))
          && request.resource.data.keys().hasOnly(['category', 'createdAt'])
          && request.resource.data.category == 'personal' && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      // Chats a person deleted from their own list (the other person's list
      // and the messages are untouched). Only the owner reads or writes.
      match /hidden_chats/{peer} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && peer != uid
          && request.resource.data.keys().hasOnly(['hiddenAt'])
          && request.resource.data.hiddenAt == request.time;
      }
      match /cows/{cow} {
        function profile() { return get(/databases/$(database)/documents/profiles/$(uid)).data; }
        allow read: if signedIn() && (request.auth.uid == uid || (profile().get('shareRanch', false) == true && exists(/databases/$(database)/documents/ranches/$(profile().ranchId)/members/$(uid)) && get(/databases/$(database)/documents/ranches/$(profile().ranchId)/members/$(uid)).data.get('active', true) != false && get(/databases/$(database)/documents/ranches/$(profile().ranchId)/members/$(uid)).data.get('status', 'active') == 'active'));
        allow create, update: if signedIn() && request.auth.uid == uid && profile().get('shareRanch', false) == true && isMember(profile().ranchId)
          && request.resource.data.keys().hasOnly(['name', 'cowId', 'photo', 'breed'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 160
          && request.resource.data.cowId is string && request.resource.data.cowId.size() <= 160
          && request.resource.data.photo is string && request.resource.data.photo.size() <= 700000
          && request.resource.data.breed is string && request.resource.data.breed.size() <= 160;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /followers/{viewer} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == viewer && viewer != uid
          && exists(/databases/$(database)/documents/profiles/$(uid))
          && exists(/databases/$(database)/documents/profiles/$(viewer))
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/profiles/$(viewer)/following/$(uid)).data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == viewer
          && !existsAfter(/databases/$(database)/documents/profiles/$(viewer)/following/$(uid));
      }
      match /following/{target} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid && target != uid
          && exists(/databases/$(database)/documents/profiles/$(uid))
          && exists(/databases/$(database)/documents/profiles/$(target))
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/profiles/$(target)/followers/$(uid)).data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid
          && !existsAfter(/databases/$(database)/documents/profiles/$(target)/followers/$(uid));
      }
    }

    // Public-to-authenticated registry used only to check Ranch ID
    // availability and locate an existing ranch. It contains no ranch records.
    match /ranch_ids/{ranchId} {
      allow read: if signedIn();
      // A Ranch ID cannot reuse a person's username (one namespace).
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(ranchId));
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /social_posts/{postId} {
      function validAuthor(data) {
        return signedIn() && data.authorUid == request.auth.uid
          && data.ranchId is string && (data.ranchId == '' || isMember(data.ranchId))
          && data.authorName is string && data.authorName.size() <= 120
          && (!('authorUsername' in data) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == data.authorUsername);
      }
      // The composer reads its new ID before writing in a transaction.
      // Keep that missing-document check out of list-query authorization.
      allow get: if signedIn() && !exists(/databases/$(database)/documents/social_posts/$(postId));
      allow get, list: if signedIn() && resource.data.createdAt <= request.time;
      allow get, list: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow create: if validAuthor(request.resource.data)
        && request.resource.data.keys().hasOnly(['authorUid', 'ranchId', 'authorName', 'authorUsername', 'text', 'mentions', 'photo', 'voice', 'voiceSeconds', 'tile', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.get('mentions', []) is list && request.resource.data.get('mentions', []).size() <= 20
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 600000
        && request.resource.data.voice is string && request.resource.data.voice.size() <= 450000
        && request.resource.data.photo.size() + request.resource.data.voice.size() <= 850000
        && request.resource.data.text.size() + request.resource.data.photo.size() + request.resource.data.voice.size() > 0
        && request.resource.data.voiceSeconds is int && request.resource.data.voiceSeconds >= 0 && request.resource.data.voiceSeconds <= 20
        && request.resource.data.tile is bool && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt >= request.time && request.resource.data.createdAt <= request.time + duration.value(366, 'd');
      allow update: if signedIn() && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is timestamp && request.resource.data.createdAt > request.time
        && request.resource.data.createdAt <= request.time + duration.value(366, 'd');
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == userId
          && exists(/databases/$(database)/documents/social_posts/$(postId))
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if validAuthor(request.resource.data)
          && exists(/databases/$(database)/documents/social_posts/$(postId))
          && request.resource.data.keys().hasOnly(['authorUid', 'ranchId', 'authorName', 'authorUsername', 'text', 'mentions', 'createdAt'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.get('mentions', []) is list && request.resource.data.get('mentions', []).size() <= 20
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
        allow update: if false;
        match /likes/{userId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.auth.uid == userId
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;
          allow delete: if signedIn() && request.auth.uid == userId;
          allow update: if false;
        }
        match /reports/{reporterId} {
          allow create: if signedIn() && request.auth.uid == reporterId
            && request.resource.data.reporterUid == request.auth.uid
            && request.resource.data.reason is string
            && request.resource.data.reason.size() <= 200
            && request.resource.data.createdAt == request.time;
          allow read, update, delete: if false;
        }
      }
      match /reports/{reporterId} {
        allow create: if signedIn() && request.auth.uid == reporterId
          && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 200
          && request.resource.data.createdAt == request.time;
        allow read, update, delete: if false;
      }
    }

    // A vendor links a customer or supplier to their VIMO ID (a username or
    // a Ranch ID). The person who was added answers once: accept or reject.
    // The request carries names only, never records or money.
    match /link_requests/{linkId} {
      function validLink(d) {
        return d.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'toId', 'toKind', 'personName', 'role', 'status', 'createdAt', 'respondedAt'])
          && d.fromUid == request.auth.uid
          && linkId == request.auth.uid + '__' + linkId.split('__')[1]
          && d.toUid is string && d.toUid.size() > 0 && d.toUid != request.auth.uid
          && d.fromName is string && d.fromName.size() > 0 && d.fromName.size() <= 80
          && d.personName is string && d.personName.size() > 0 && d.personName.size() <= 80
          && d.role in ['customer', 'supplier']
          && d.toId is string && d.toId.size() > 0 && d.toId.size() <= 40
          && (
            (d.toKind == 'person'
              && get(/databases/$(database)/documents/usernames/$(d.toId)).data.uid == d.toUid)
            || (d.toKind == 'ranch'
              && get(/databases/$(database)/documents/ranch_ids/$(d.toId)).data.ownerUid == d.toUid)
          )
          && d.status == 'pending'
          && d.createdAt == request.time
          && !('respondedAt' in d);
      }
      function party() {
        return signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      }
      allow get, list: if party();
      allow create: if signedIn() && validLink(request.resource.data);
      allow update: if signedIn() && (
        // The vendor sends it again (another ID, or after a rejection).
        (resource.data.fromUid == request.auth.uid && validLink(request.resource.data))
        // The person who was added answers once.
        || (resource.data.toUid == request.auth.uid && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.respondedAt == request.time)
      );
      allow delete: if party();
    }

    // Public part of an animal shared into a chat: only a photo. Name, breed
    // and age travel inside the message itself; ranch records never do.
    match /shared_cards/{cardId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'kind', 'photo', 'photoUrl', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind == 'animal'
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 300000
        && (request.resource.data.photo == '' || request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 1000
        && (request.resource.data.photoUrl == '' || request.resource.data.photoUrl.matches('^https://.+$'))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // A vendor route lent to one person for a limited time. The owner can
    // extend or stop it; the recipient can only answer and report deliveries.
    // Shared stops carry name, place, litres and (optionally) balance only.
    match /route_shares/{shareId} {
      function routeOwner() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
      function routeRecipient() { return signedIn() && resource.data.recipientUid == request.auth.uid; }
      allow get: if routeOwner() || routeRecipient();
      allow list: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'recipientUid', 'routeName', 'route', 'collectLater', 'status', 'response', 'progress', 'expiresAt', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.recipientUid is string && request.resource.data.recipientUid.size() > 0
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 80
        && request.resource.data.routeName is string && request.resource.data.routeName.size() > 0 && request.resource.data.routeName.size() <= 80
        && request.resource.data.route is map && request.resource.data.route.keys().hasOnly(['path', 'stops', 'notes'])
        && request.resource.data.collectLater is bool
        && request.resource.data.status == 'active' && request.resource.data.response == 'pending'
        && request.resource.data.progress is map && request.resource.data.progress.size() == 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (routeOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expiresAt', 'updatedAt'])
          && request.resource.data.status in ['active', 'stopped']
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt <= request.time + duration.value(15, 'd')
          && request.resource.data.updatedAt == request.time)
        || (routeRecipient()
          && resource.data.status == 'active' && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response', 'progress', 'updatedAt'])
          && request.resource.data.response in ['accepted', 'rejected']
          && request.resource.data.progress is map
          && request.resource.data.updatedAt == request.time);
      allow delete: if routeOwner();
    }

    // Shop products a person lists from their profile. Anyone signed in can
    // read; only the seller writes. Photos live one per document beside it.
    match /shop_products/{productId} {
      function jpeg(v, max) {
        return v is string && v.size() <= max
          && v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
      }
      function validProduct(d) {
        return d.keys().hasOnly(['sellerUid', 'sellerName', 'title', 'description', 'features', 'category', 'condition', 'brand', 'tags', 'searchTerms', 'price', 'mrp', 'unit', 'unitSize', 'stock', 'maxPerOrder', 'sku', 'weightGrams', 'origin', 'manufacturer', 'gstPercent', 'hsn', 'delivery', 'returns', 'cover', 'photoCount', 'status', 'createdAt', 'updatedAt'])
          && d.sellerUid == request.auth.uid
          && d.sellerName is string && d.sellerName.size() > 0 && d.sellerName.size() <= 80
          && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
          && d.description is string && d.description.size() <= 2000
          && d.features is list && d.features.size() <= 5
          && d.category in ['dairy', 'ghee', 'feed', 'animals', 'equipment', 'produce', 'grains', 'organic', 'home', 'clothing', 'electronics', 'other']
          && d.condition in ['new', 'like_new', 'good', 'fair', 'poor']
          && d.brand is string && d.brand.size() <= 60
          && d.tags is list && d.tags.size() <= 5
          && d.searchTerms is list && d.searchTerms.size() <= 60
          && d.price is number && d.price > 0 && d.price <= 10000000
          && d.mrp is number && (d.mrp == 0 || d.mrp >= d.price)
          && d.unit in ['piece', 'litre', 'kg', 'pack', 'dozen']
          && d.unitSize is string && d.unitSize.size() <= 20
          && d.stock is int && d.stock >= 0 && d.stock <= 100000
          // The seller decides how many one order may take (1 for a cow).
          && d.maxPerOrder is int && d.maxPerOrder >= 1 && d.maxPerOrder <= 100000
          && d.sku is string && d.sku.size() <= 40
          && d.weightGrams is int && d.weightGrams >= 0 && d.weightGrams <= 1000000
          && d.origin is string && d.origin.size() <= 40
          && d.manufacturer is string && d.manufacturer.size() <= 120
          && d.gstPercent in [0, 5, 12, 18, 28]
          && d.hsn is string && d.hsn.matches('^([0-9]{4,8})?$')
          && d.delivery is map && d.delivery.keys().hasOnly(['methods', 'payer', 'fee', 'days', 'shipsFrom'])
          && d.delivery.methods is list && d.delivery.methods.size() >= 1 && d.delivery.methods.size() <= 3
          && d.delivery.methods.hasOnly(['pickup', 'seller_delivery', 'courier'])
          && d.delivery.payer in ['seller', 'buyer']
          && d.delivery.fee is number && d.delivery.fee >= 0 && d.delivery.fee <= 100000
          && d.delivery.days in ['1-2', '2-3', '4-7']
          && d.delivery.shipsFrom is string && d.delivery.shipsFrom.size() <= 80
          && d.returns in ['none', '7days']
          && jpeg(d.cover, 80000)
          && d.photoCount is int && d.photoCount >= 1 && d.photoCount <= 5
          && d.status in ['active', 'paused']
          && d.updatedAt == request.time;
      }
      allow read: if signedIn();
      allow create: if signedIn() && !marketBlocked() && validProduct(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if (signedIn() && resource.data.sellerUid == request.auth.uid
        && !marketBlocked()
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt)
        // The VIMO Team takes a listing down.
        || (isVimoTeam() && request.resource.data.status == 'paused'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt == request.time);
      allow delete: if signedIn() && resource.data.sellerUid == request.auth.uid;

      match /photos/{index} {
        allow read: if signedIn();
        allow create, update: if signedIn() && index in ['0', '1', '2', '3', '4']
          && getAfter(/databases/$(database)/documents/shop_products/$(productId)).data.sellerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['data'])
          && jpeg(request.resource.data.data, 450000);
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/shop_products/$(productId)).data.sellerUid == request.auth.uid;
      }
    }

    // Orders, Mercari style. The buyer orders at the product's own price,
    // fee and stock; then each side may take only its own next step:
    // seller accepts and sends, buyer confirms receipt and rates, seller
    // rates and completes. Cancelling takes both: before it is sent, one
    // asks with a reason and the other agrees (or declines); while a request
    // is open the order does not move. Money never passes through VIMO.
    match /shop_orders/{orderId} {
      function product() {
        return get(/databases/$(database)/documents/shop_products/$(request.resource.data.productId)).data;
      }
      function validAddress(a) {
        return a is map && (a.size() == 0 || (a.keys().hasOnly(['name', 'phone', 'line', 'city', 'pincode'])
          && a.name is string && a.name.size() > 0 && a.name.size() <= 80
          && a.phone is string && a.phone.matches('^[+]?[0-9]{10,13}$')
          && a.line is string && a.line.size() >= 5 && a.line.size() <= 300
          && a.city is string && a.city.size() > 0 && a.city.size() <= 80
          && a.pincode is string && a.pincode.matches('^[1-9][0-9]{5}$')));
      }
      function validRating(r) {
        return r is map && r.keys().hasOnly(['score', 'text'])
          && r.score in ['good', 'bad'] && r.text is string && r.text.size() <= 300;
      }
      function validOrder(d) {
        return d.keys().hasOnly(['productId', 'sellerUid', 'buyerUid', 'sellerName', 'buyerName', 'title', 'cover', 'unitPrice', 'quantity', 'deliveryMethod', 'deliveryFee', 'total', 'payment', 'address', 'note', 'status', 'createdAt', 'updatedAt'])
          && d.buyerUid == request.auth.uid
          && d.sellerUid == product().sellerUid
          && d.sellerUid != request.auth.uid
          && product().status == 'active'
          && d.quantity is int && d.quantity >= 1 && d.quantity <= product().stock
          && d.quantity <= product().maxPerOrder
          && d.unitPrice == product().price
          && d.deliveryMethod in product().delivery.methods
          && d.deliveryFee == ((d.deliveryMethod == 'pickup' || product().delivery.payer != 'buyer') ? 0 : product().delivery.fee)
          && d.total == d.unitPrice * d.quantity + d.deliveryFee
          && d.payment in ['cod', 'upi']
          && validAddress(d.address)
          && (d.deliveryMethod == 'pickup' || d.address.size() > 0)
          && d.title == product().title && d.cover == product().cover
          && d.sellerName is string && d.sellerName.size() > 0 && d.sellerName.size() <= 80
          && d.buyerName is string && d.buyerName.size() > 0 && d.buyerName.size() <= 80
          && d.note is string && d.note.size() <= 300
          && d.status == 'ordered'
          && d.createdAt == request.time && d.updatedAt == request.time;
      }
      function changed(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      function moves(from, to) {
        return resource.data.status == from && request.resource.data.status == to
          && request.resource.data.updatedAt == request.time;
      }
      function isSeller() { return request.auth.uid == resource.data.sellerUid; }
      function isBuyer() { return request.auth.uid == resource.data.buyerUid; }
      function role() { return isSeller() ? 'seller' : 'buyer'; }
      function isParty() { return isSeller() || isBuyer(); }
      function asking() { return 'cancelRequest' in resource.data; }
      function cancellable() { return resource.data.status in ['ordered', 'accepted']; }
      function asksCancel() {
        let r = request.resource.data.cancelRequest;
        return cancellable() && !asking()
          && changed(['cancelRequest', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && r is map && r.keys().hasOnly(['by', 'reason', 'at'])
          && r.by == role() && r.at == request.time
          && r.reason is string && r.reason.size() > 0 && r.reason.size() <= 200;
      }
      // The asker takes it back, or the other person declines.
      function dropsCancel() {
        return asking() && !('cancelRequest' in request.resource.data)
          && changed(['cancelRequest', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }
      // Only the other person can agree; the seller then restocks at once.
      function agreesCancel() {
        let d = request.resource.data;
        return asking() && resource.data.cancelRequest.by != role()
          && cancellable() && d.status == 'cancelled' && d.updatedAt == request.time
          && !('cancelRequest' in d)
          && changed(['status', 'updatedAt', 'cancelledAt', 'cancelledBy', 'cancelReason', 'cancelRequest', 'restocked'])
          && d.cancelledAt == request.time
          && d.cancelledBy == resource.data.cancelRequest.by
          && d.cancelReason == resource.data.cancelRequest.reason
          && (!('restocked' in d) || (isSeller() && d.restocked == true && resource.data.status == 'accepted'));
      }
      // When the buyer gave the final yes, the seller may restock later.
      function restocks() {
        return resource.data.status == 'cancelled' && 'acceptedAt' in resource.data
          && !('restocked' in resource.data)
          && changed(['restocked', 'updatedAt'])
          && request.resource.data.restocked == true
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if (signedIn()
        && (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid))
        || reportedOrder(orderId);
      allow create: if signedIn() && !marketBlocked() && validOrder(request.resource.data);
      allow update: if signedIn() && (
        (isSeller() && !asking() && moves('ordered', 'accepted')
          && changed(['status', 'updatedAt', 'acceptedAt', 'sellerUpi'])
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.sellerUpi is string && request.resource.data.sellerUpi.size() <= 60)
        || (isSeller() && !asking() && moves('accepted', 'shipped')
          && changed(['status', 'updatedAt', 'shippedAt', 'tracking'])
          && request.resource.data.shippedAt == request.time
          && request.resource.data.tracking is string && request.resource.data.tracking.size() <= 200)
        || (isBuyer() && moves('shipped', 'received')
          && changed(['status', 'updatedAt', 'receivedAt', 'buyerRating'])
          && request.resource.data.receivedAt == request.time
          && validRating(request.resource.data.buyerRating))
        || (isSeller() && moves('received', 'completed')
          && changed(['status', 'updatedAt', 'completedAt', 'sellerRating'])
          && request.resource.data.completedAt == request.time
          && validRating(request.resource.data.sellerRating))
        || (isParty() && (asksCancel() || dropsCancel() || agreesCancel()))
        || (isSeller() && restocks())
        // After a report, the VIMO Team may end an order that is not done.
        || (reportedOrder(orderId)
          && resource.data.status in ['ordered', 'accepted', 'shipped', 'received']
          && request.resource.data.status == 'cancelled'
          && !('cancelRequest' in request.resource.data)
          && changed(['status', 'updatedAt', 'cancelledAt', 'cancelledBy', 'cancelReason', 'cancelRequest'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.cancelledBy == 'vimo'
          && request.resource.data.cancelReason is string && request.resource.data.cancelReason.size() <= 200)
      );
      allow delete: if false;

      match /messages/{messageId} {
        function order() {
          return get(/databases/$(database)/documents/shop_orders/$(orderId)).data;
        }
        function party() {
          return request.auth.uid == order().buyerUid || request.auth.uid == order().sellerUid;
        }
        allow read: if (signedIn() && party()) || reportedOrder(orderId);
        allow create: if signedIn() && party()
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Nearby milk search. A vendor or shop chooses to be listed; the place is
    // stored only as a ~220 m grid square (gridLat/gridLng = degrees x 500),
    // never the exact spot. "cell" is the ~5.5 km square used to find
    // listings near a buyer and must match the grid.
    match /vendor_listings/{uid} {
      function validTime(t) {
        return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }
      function validHours(h) {
        return h is map && (h.size() == 0
          || (h.keys().hasOnly(['start', 'end']) && validTime(h.start) && validTime(h.end)));
      }
      // A cell is 25 x 25 grid squares; the grid square must fall inside it.
      function inCell(grid, cell) {
        return cell * 25 <= grid && grid < cell * 25 + 25;
      }
      function validListing(d) {
        return d.keys().hasOnly(['name', 'nameFold', 'kind', 'gridLat', 'gridLng', 'cell', 'price', 'morning', 'evening', 'active', 'holiday', 'onRide', 'rideAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          // Lower-case name for searching Market by name.
          && (!('nameFold' in d) || d.nameFold == d.name.lower())
          && d.kind in ['vendor', 'shop', 'ranch']
          && d.gridLat is int && d.gridLat >= -45000 && d.gridLat <= 45000
          && d.gridLng is int && d.gridLng >= -90000 && d.gridLng <= 90000
          && d.cell is string && d.cell.matches('^-?[0-9]{1,4}:-?[0-9]{1,4}$')
          && inCell(d.gridLat, int(d.cell.split(':')[0]))
          && inCell(d.gridLng, int(d.cell.split(':')[1]))
          && d.price is number && d.price >= 0 && d.price <= 1000
          && validHours(d.morning) && validHours(d.evening)
          && d.active is bool && d.holiday is bool && d.onRide is bool
          && (!('rideAt' in d) || d.rideAt is timestamp)
          && d.updatedAt == request.time;
      }
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && !marketBlocked()
        && validListing(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;

      // One review per buyer, and only from a real buyer: an accepted milk
      // request with this vendor, or an accepted VIMO ID link from them.
      match /reviews/{buyerUid} {
        function realBuyer(d) {
          return (d.proofKind == 'request'
              && get(/databases/$(database)/documents/milk_requests/$(d.proof)).data.buyerUid == request.auth.uid
              && get(/databases/$(database)/documents/milk_requests/$(d.proof)).data.vendorUid == uid
              && 'acceptedAt' in get(/databases/$(database)/documents/milk_requests/$(d.proof)).data)
            || (d.proofKind == 'link'
              && get(/databases/$(database)/documents/link_requests/$(d.proof)).data.fromUid == uid
              && get(/databases/$(database)/documents/link_requests/$(d.proof)).data.toUid == request.auth.uid
              && get(/databases/$(database)/documents/link_requests/$(d.proof)).data.status == 'accepted');
        }
        function validReview(d) {
          return d.keys().hasOnly(['stars', 'text', 'buyerName', 'proof', 'proofKind', 'createdAt', 'updatedAt'])
            && d.stars is int && d.stars >= 1 && d.stars <= 5
            && d.text is string && d.text.size() <= 300
            && d.buyerName is string && d.buyerName.size() > 0 && d.buyerName.size() <= 80
            && d.proof is string && d.proof.size() > 0 && d.proof.size() <= 200
            && d.proofKind in ['request', 'link']
            && d.updatedAt == request.time
            && realBuyer(d);
        }
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == buyerUid && buyerUid != uid
          && exists(/databases/$(database)/documents/vendor_listings/$(uid))
          && validReview(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && request.auth.uid == buyerUid
          && validReview(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if signedIn() && request.auth.uid == buyerUid;
      }
    }

    // A buyer asks a listed vendor for milk, for today only or regularly.
    // Only the two of them can read it. The vendor accepts, offers another
    // time or price, or declines; either side can cancel. The vendor's exact
    // place is added only after acceptance. Requests are never deleted
    // because an accepted one is the proof behind a review.
    match /milk_requests/{requestId} {
      function validPoint(p) {
        return p is map && p.keys().hasOnly(['lat', 'lng'])
          && p.lat is number && p.lat >= -90 && p.lat <= 90
          && p.lng is number && p.lng >= -180 && p.lng <= 180;
      }
      function validRequest(d) {
        return d.keys().hasOnly(['buyerUid', 'buyerName', 'vendorUid', 'vendorName', 'kind', 'litres', 'session', 'time', 'days', 'payment', 'home', 'note', 'status', 'createdAt', 'updatedAt'])
          && d.buyerUid == request.auth.uid
          && d.vendorUid is string && d.vendorUid != request.auth.uid
          && get(/databases/$(database)/documents/vendor_listings/$(d.vendorUid)).data.active == true
          && d.buyerName is string && d.buyerName.size() > 0 && d.buyerName.size() <= 80
          && d.vendorName is string && d.vendorName.size() <= 80
          && d.kind in ['today', 'regular']
          && d.litres is number && d.litres > 0 && d.litres <= 50
          && d.session in ['Morning', 'Evening']
          && d.time is string && d.time.matches('^(([01][0-9]|2[0-3]):[0-5][0-9])?$')
          && d.days is list && d.days.hasOnly(['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'])
          && (d.kind == 'today' ? d.days.size() == 0 && d.payment == '' : d.days.size() > 0 && d.payment in ['daily', 'weekly', 'monthly'])
          && d.home is map && (d.home.size() == 0 || validPoint(d.home))
          && d.note is string && d.note.size() <= 200
          && d.status == 'pending'
          && d.createdAt == request.time && d.updatedAt == request.time;
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function offer(d) {
        return (!('offerTime' in d) || d.offerTime is string && d.offerTime.matches('^(([01][0-9]|2[0-3]):[0-5][0-9])?$'))
          && (!('offerPrice' in d) || (d.offerPrice is number && d.offerPrice >= 0 && d.offerPrice <= 1000));
      }
      function isVendor() { return signedIn() && resource.data.vendorUid == request.auth.uid; }
      function isBuyer() { return signedIn() && resource.data.buyerUid == request.auth.uid; }
      allow get, list: if isVendor() || isBuyer();
      allow create: if signedIn() && validRequest(request.resource.data);
      allow update: if request.resource.data.updatedAt == request.time && (
        // The vendor answers a new request once.
        (isVendor() && resource.data.status == 'pending'
          && changed().hasOnly(['status', 'offerTime', 'offerPrice', 'vendorPoint', 'acceptedAt', 'updatedAt'])
          && offer(request.resource.data)
          && (
            (request.resource.data.status == 'accepted'
              && request.resource.data.acceptedAt == request.time
              && validPoint(request.resource.data.vendorPoint))
            || (request.resource.data.status in ['offered', 'declined']
              && !('acceptedAt' in request.resource.data)
              && !('vendorPoint' in request.resource.data))
          ))
        // The buyer agrees to the vendor's time or price.
        || (isBuyer() && resource.data.status == 'offered'
          && changed().hasOnly(['status', 'acceptedAt', 'updatedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedAt == request.time)
        // After the buyer agrees, the vendor shares their exact place.
        || (isVendor() && resource.data.status == 'accepted'
          && changed().hasOnly(['vendorPoint', 'updatedAt'])
          && validPoint(request.resource.data.vendorPoint))
        // Either side can stop an open or running request.
        || ((isVendor() || isBuyer()) && resource.data.status in ['pending', 'offered', 'accepted']
          && changed().hasOnly(['status', 'cancelledBy', 'updatedAt'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == request.auth.uid)
      );
      allow delete: if false;
    }

    match /direct_chats/{chat} {
      function participant() { return signedIn() && request.auth.uid in resource.data.participants; }
      allow read: if participant() || reportedChat(chat);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['participants'])
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && chat == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants;
      allow update: if participant() && request.resource.data == resource.data;
      allow delete: if false;
      match /messages/{message} {
        function member() { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chat)).data.participants; }
        allow read: if member() || reportedChat(chat);
        allow create: if member() && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /ranches/{ranchId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(ranchId)
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && resource.data.authUid == request.auth.uid);
      // Admins may edit ranch details, but only the owner can change who
      // owns the ranch.
      allow update: if (isAdmin(ranchId) && ownerFieldsKept())
        || isRanchOwner();
      allow delete: if false;

      function isRanchOwner() {
        return signedIn()
          && (resource.data.get('ownerUid', '') == request.auth.uid
            || resource.data.get('authUid', '') == request.auth.uid);
      }
      function ownerFieldsKept() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'authUid']);
      }
      function ranchOwnerUid() {
        let ranch = get(/databases/$(database)/documents/ranches/$(ranchId)).data;
        return ranch.get('ownerUid', ranch.get('authUid', ''));
      }

      match /members/{memberId} {
        allow read: if isMember(ranchId)
          || (signedIn() && request.auth.uid == memberId);
        allow create: if isAdmin(ranchId)
          || (
            signedIn()
            && request.auth.uid == memberId
            && getAfter(/databases/$(database)/documents/ranches/$(ranchId)).data.ownerUid == request.auth.uid
          )
          || (
            signedIn()
            && request.auth.uid == memberId
            && get(/databases/$(database)/documents/ranches/$(ranchId)).data.authUid == request.auth.uid
          );
        // Another admin cannot demote or remove the ranch owner.
        allow update, delete: if isAdmin(ranchId)
          && (memberId != ranchOwnerUid() || request.auth.uid == memberId);
      }

      match /join_requests/{requesterId} {
        // A new request is always pending; only an admin approves it.
        allow create: if signedIn()
          && request.auth.uid == requesterId
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'status', 'requestedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 120
          && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 254
          && exists(/databases/$(database)/documents/ranch_ids/$(ranchId));
        allow read: if isAdmin(ranchId)
          || (signedIn() && request.auth.uid == requesterId);
        allow update: if isAdmin(ranchId)
          || (
            signedIn()
            && request.auth.uid == requesterId
            && resource.data.uid == request.auth.uid
            && resource.data.status in ['pending', 'rejected']
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending'
          );
        allow delete: if isAdmin(ranchId)
          || (signedIn() && request.auth.uid == requesterId);
      }

      match /animals/{documentId} {
        allow read: if isMember(ranchId);
        allow create, delete: if canEditAnimals(ranchId);
        allow update: if canEditAnimals(ranchId)
          || canUpdateAnimalEntry(ranchId);
      }

      match /vendor_people/{personId} {
        allow read: if isMember(ranchId);
        allow create, update: if canRecordEntries(ranchId)
          && request.resource.data.id == personId
          && request.resource.data.kind in ['supplier', 'customer']
          && (resource == null || request.resource.data.kind == resource.data.kind)
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.place is string && request.resource.data.place.size() <= 160
          && request.resource.data.days is list && request.resource.data.days.hasOnly([0, 1, 2, 3, 4, 5, 6])
          && request.resource.data.sessions is list && request.resource.data.sessions.hasOnly(['Morning', 'Evening'])
          && request.resource.data.paymentCycle in ['Daily', 'Every 2 days', 'Weekly', 'Monthly', 'Flexible']
          && request.resource.data.get('contact', '') is string && request.resource.data.get('contact', '').size() <= 40
          && request.resource.data.get('imageData', '') is string && request.resource.data.get('imageData', '').size() <= 700000
          && request.resource.data.get('quantity', 1) is number && request.resource.data.get('quantity', 1) > 0
          && request.resource.data.get('price', 1) is number && request.resource.data.get('price', 1) > 0
          && request.resource.data.get('paymentDays', []) is list && request.resource.data.get('paymentDays', []).hasOnly([0, 1, 2, 3, 4, 5, 6])
          && request.resource.data.get('paymentMonthDay', 1) is int && request.resource.data.get('paymentMonthDay', 1) >= 1 && request.resource.data.get('paymentMonthDay', 1) <= 31
          && request.resource.data.get('routeOrder', {}) is map
          // Optional VIMO ID link (the request itself lives in link_requests).
          && request.resource.data.get('vimoId', '') is string && request.resource.data.get('vimoId', '').size() <= 40
          && request.resource.data.get('vimoUid', '') is string && request.resource.data.get('vimoUid', '').size() <= 128
          && request.resource.data.get('vimoKind', '') in ['', 'person', 'ranch']
          // Optional home location; null clears a saved one.
          && (request.resource.data.get('lat', null) == null
            || (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
          && (request.resource.data.get('lng', null) == null
            || (request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180));
        allow delete: if false;
      }

      function vendorEntry(entryId) {
        return getAfter(/databases/$(database)/documents/ranches/$(ranchId)/vendor_entries/$(entryId)).data;
      }
      function newVendorEntry(entryId) {
        return !exists(/databases/$(database)/documents/ranches/$(ranchId)/vendor_entries/$(entryId))
          && vendorEntry(entryId).createdByUid == request.auth.uid;
      }
      function stockChange(entry) {
        return entry.kind in ['collection', 'purchase', 'ranch'] ? entry.quantity : entry.kind in ['sale', 'clearance'] ? -entry.quantity : 0;
      }
      function sourceMilk(box, id) {
        let path = /databases/$(database)/documents/ranches/$(ranchId)/$(box)/$(id);
        return !exists(path) ? 0 : box == 'milk_records' ? get(path).data.quantity
          : (get(path).data.get('type', '') == 'Milk' || get(path).data.get('category', '') == 'Milk Sale') ? -get(path).data.quantity : 0;
      }
      function validRanchEntry(entry, id) {
        let path = /databases/$(database)/documents/ranches/$(ranchId)/vendor_ranch_links/$(entry.linkId);
        return entry.kind == 'ranch' && entry.sourceBox in ['milk_records', 'sale_records']
          && entry.linkId == entry.sourceBox + '_' + entry.sourceId
          && entry.createdByUid == request.auth.uid && entry.cloudId == id
          && entry.serverCreatedAt == request.time && entry.quantity is number
          && math.abs(entry.quantity - (sourceMilk(entry.sourceBox, entry.sourceId) - (exists(path) ? get(path).data.quantity : 0))) < 0.00001
          && getAfter(path).data.entryId == id
          && getAfter(/databases/$(database)/documents/ranches/$(ranchId)/vendor_stock/milk).data.entryId == id;
      }
      match /vendor_ranch_links/{linkId} {
        allow read: if isMember(ranchId);
        allow create, update: if canRecordEntries(ranchId)
          && request.resource.data.keys().hasOnly(['sourceBox', 'sourceId', 'quantity', 'entryId'])
          && request.resource.data.sourceBox in ['milk_records', 'sale_records']
          && linkId == request.resource.data.sourceBox + '_' + request.resource.data.sourceId
          && newVendorEntry(request.resource.data.entryId)
          && vendorEntry(request.resource.data.entryId).linkId == linkId
          && request.resource.data.quantity == sourceMilk(request.resource.data.sourceBox, request.resource.data.sourceId);
        allow delete: if false;
      }
      function dueChange(entry) {
        return entry.kind == 'payment' ? -entry.amount : entry.amount - entry.paid;
      }
      match /vendor_stock/{stockId} {
        allow read: if isMember(ranchId);
        // One-time, admin-owned cutover. Retain the original ledger and stock.
        allow create: if isAdmin(ranchId) && stockId == 'vendor_milk'
          && request.resource.data.keys().hasOnly(['quantity', 'entryId'])
          && request.resource.data.entryId == 'migration_v2'
          && request.resource.data.quantity is number && request.resource.data.quantity >= 0;
        allow create, update: if canRecordEntries(ranchId) && stockId == 'vendor_milk'
          && request.resource.data.keys().hasOnly(['quantity', 'entryId'])
          && newVendorEntry(request.resource.data.entryId)
          && vendorEntry(request.resource.data.entryId).stockScope == 'vendor_v2'
          && vendorEntry(request.resource.data.entryId).kind in ['collection', 'purchase', 'sale', 'payment']
          && request.resource.data.quantity is number && request.resource.data.quantity >= 0
          && math.abs(request.resource.data.quantity - ((resource == null ? 0 : resource.data.quantity) + stockChange(vendorEntry(request.resource.data.entryId)))) < 0.00001;
        allow delete: if false;
      }
      match /vendor_accounts/{personId} {
        allow read: if isMember(ranchId);
        allow create, update: if canRecordEntries(ranchId)
          && request.resource.data.keys().hasOnly(['due', 'entryId'])
          && newVendorEntry(request.resource.data.entryId)
          && vendorEntry(request.resource.data.entryId).personId == personId
          && request.resource.data.due is number && request.resource.data.due >= 0
          && math.abs(request.resource.data.due - ((resource == null ? 0 : resource.data.due) + dueChange(vendorEntry(request.resource.data.entryId)))) < 0.011;
        allow delete: if false;
      }
      match /vendor_entries/{entryId} {
        allow read: if isMember(ranchId);
        allow create: if canRecordEntries(ranchId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.cloudId == entryId
          && request.resource.data.serverCreatedAt == request.time
          && request.resource.data.stockScope == 'vendor_v2'
          && request.resource.data.kind in ['collection', 'purchase', 'sale', 'payment', 'clearance']
          // Clearance moves unsold milk out of stock at no charge: to the
          // fridge or to any person. It never changes a balance.
          && (request.resource.data.kind == 'clearance'
            ? (request.resource.data.personKind in ['fridge', 'supplier', 'customer']
              && (request.resource.data.personKind == 'fridge'
                ? request.resource.data.personId == '_fridge'
                : get(/databases/$(database)/documents/ranches/$(ranchId)/vendor_people/$(request.resource.data.personId)).data.kind == request.resource.data.personKind)
              && request.resource.data.quantity is number && request.resource.data.quantity > 0
              && request.resource.data.price == 0 && request.resource.data.amount == 0 && request.resource.data.paid == 0
              && request.resource.data.get('syncMode', '') == 'local_v3')
            : (get(/databases/$(database)/documents/ranches/$(ranchId)/vendor_people/$(request.resource.data.personId)).data.kind == request.resource.data.personKind
              && (request.resource.data.kind == 'payment' || (request.resource.data.kind in ['collection', 'purchase'] && request.resource.data.personKind == 'supplier') || (request.resource.data.kind == 'sale' && request.resource.data.personKind == 'customer'))
              && request.resource.data.quantity is number && request.resource.data.quantity >= 0
              && request.resource.data.price is number && request.resource.data.price >= 0
              && request.resource.data.amount is number && request.resource.data.amount > 0
              && request.resource.data.paid is number && request.resource.data.paid >= 0 && request.resource.data.paid <= request.resource.data.amount
              && (request.resource.data.kind == 'payment' || (request.resource.data.quantity > 0 && request.resource.data.price > 0 && math.abs(request.resource.data.amount - request.resource.data.quantity * request.resource.data.price) < 0.011))))
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 500
          // Optional member sharing relays the device's immutable ledger.
          // Local v3 entries derive stock and balances from ledger rows.
          && (request.resource.data.get('syncMode', '') == 'local_v3'
            || (getAfter(/databases/$(database)/documents/ranches/$(ranchId)/vendor_stock/vendor_milk).data.entryId == entryId
              && getAfter(/databases/$(database)/documents/ranches/$(ranchId)/vendor_accounts/$(request.resource.data.personId)).data.entryId == entryId));
        allow update: if canRecordEntries(ranchId)
          && resource.data.createdByUid == request.auth.uid
          && request.time < resource.data.serverCreatedAt + duration.value(5, 'm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'updatedAtMillis', 'updatedAtText', 'updatedBy'])
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 500;
        allow delete: if false;
      }

      // Milk shop counter: sales and stock additions. Rows are never deleted;
      // the person who made a sale may only mark it cancelled.
      function validShopEntry(d) {
        return d.kind in ['sale', 'stock']
          && d.itemId is string && d.itemId.size() > 0 && d.itemId.size() <= 60
          && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 60
          && d.unit in ['litre', 'kg', 'count']
          && d.quantity is number && d.quantity > 0 && d.quantity <= 100000
          && d.price is number && d.price >= 0 && d.price <= 1000000
          && (d.kind == 'stock' ? d.price == 0 : d.price > 0)
          && d.amount is number && math.abs(d.amount - d.quantity * d.price) < 0.011
          && d.get('voided', false) is bool
          && d.get('notes', '') is string && d.get('notes', '').size() <= 200;
      }
      match /shop_entries/{entryId} {
        allow read: if isMember(ranchId);
        allow create: if canRecordEntries(ranchId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.cloudId == entryId
          && request.resource.data.serverCreatedAt == request.time
          && validShopEntry(request.resource.data);
        allow update: if canRecordEntries(ranchId)
          && resource.data.createdByUid == request.auth.uid
          && resource.data.kind == 'sale'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'updatedAtMillis', 'updatedAtText', 'updatedBy'])
          && request.resource.data.voided == true;
        allow delete: if false;
      }

      match /settings/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if isAdmin(ranchId);
      }

      match /family_users/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if isAdmin(ranchId);
      }

      match /milk_records/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if canRecordEntries(ranchId);
      }

      match /food_records/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if canRecordEntries(ranchId);
      }

      match /stock_records/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if canRecordEntries(ranchId);
      }

      match /expense_records/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if canRecordEntries(ranchId);
      }

      match /doctor_records/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if canRecordEntries(ranchId);
      }

      match /purchase_records/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if canEditAnimals(ranchId);
      }

      match /sale_records/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update: if canWriteSale(ranchId);
        allow delete: if canEditAnimals(ranchId);
      }

      match /ranch_customers/{customerId} {
        allow read: if isMember(ranchId);
        allow create, update: if canRecordEntries(ranchId)
          && request.resource.data.customerId == customerId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.get('place', '') is string
          && request.resource.data.get('place', '').size() <= 160
          && request.resource.data.get('contact', '') is string
          && request.resource.data.get('contact', '').size() <= 32;
        allow delete: if isAdmin(ranchId);
      }

      match /death_records/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if canEditAnimals(ranchId);
      }

      match /calving_records/{documentId} {
        allow read: if isMember(ranchId);
        allow create, update, delete: if canEditAnimals(ranchId);
      }

      match /ranch_messages/{documentId} {
        allow read, create: if isMember(ranchId);
        allow update, delete: if signedIn()
          && isMember(ranchId)
          && (
            isAdmin(ranchId)
            || resource.data.createdByUid == request.auth.uid
          );
      }

      match /ranch_tasks/{documentId} {
        allow read, create: if isMember(ranchId);
        allow update: if isMember(ranchId);
        allow delete: if isAdmin(ranchId);
      }

      match /notifications/{documentId} {
        allow read, create, update: if isMember(ranchId);
        allow delete: if isAdmin(ranchId);
      }

      match /push_tokens/{tokenId} {
        allow read: if isMember(ranchId)
          && resource.data.uid == request.auth.uid;
        allow create, update: if isMember(ranchId)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isMember(ranchId)
          && resource.data.uid == request.auth.uid;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
      // ---- VIMO Team: reports, support messages and Market blocks ----
    match /vimo_admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // A report: what happened, between whom, and which conversation and
    // orders the team may now read. Only the reporter and the team see it.
    match /vimo_reports/{reportId} {
      function validReport(d) {
        return d.keys().hasOnly(['reporterUid', 'reporterName', 'againstUid', 'againstName', 'topic', 'reason', 'text', 'orderId', 'chatId', 'orderIds', 'status', 'createdAt', 'updatedAt'])
          && d.reporterUid == request.auth.uid
          && d.reporterName is string && d.reporterName.size() > 0 && d.reporterName.size() <= 80
          && d.againstUid is string && d.againstUid.size() > 0 && d.againstUid != request.auth.uid
          && d.againstName is string && d.againstName.size() <= 80
          && d.topic in ['order', 'chat', 'profile']
          && d.reason in ['not_received', 'not_as_described', 'payment', 'cancel', 'abuse', 'fraud', 'other']
          && d.text is string && d.text.size() >= 10 && d.text.size() <= 1000
          && d.orderId is string && d.orderId.size() <= 60
          && d.chatId in ['', d.reporterUid + '_' + d.againstUid, d.againstUid + '_' + d.reporterUid]
          && d.orderIds is list && d.orderIds.size() <= 20
          && d.status == 'open'
          && d.createdAt == request.time && d.updatedAt == request.time;
      }
      allow create: if signedIn() && validReport(request.resource.data);
      allow read: if (signedIn() && resource.data.reporterUid == request.auth.uid) || isVimoTeam();
      allow update: if isVimoTeam()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'outcome', 'handledBy', 'updatedAt'])
        && request.resource.data.status in ['open', 'reviewing', 'resolved']
        && request.resource.data.get('outcome', '') is string && request.resource.data.get('outcome', '').size() <= 1000
        && request.resource.data.get('handledBy', request.auth.uid) == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Opening a reported conversation or order to the team, written by one
    // of its own two people in the same step as the report.
    match /vimo_reported_chats/{chat} {
      allow create, update: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chat)).data.participants
        && request.resource.data.keys().hasOnly(['reportId', 'at'])
        && existsAfter(/databases/$(database)/documents/vimo_reports/$(request.resource.data.reportId))
        && request.resource.data.at == request.time;
      allow read: if isVimoTeam();
      allow delete: if false;
    }
    match /vimo_reported_orders/{order} {
      function party() {
        let o = get(/databases/$(database)/documents/shop_orders/$(order)).data;
        return request.auth.uid == o.buyerUid || request.auth.uid == o.sellerUid;
      }
      allow create, update: if signedIn() && party()
        && request.resource.data.keys().hasOnly(['reportId', 'at'])
        && existsAfter(/databases/$(database)/documents/vimo_reports/$(request.resource.data.reportId))
        && request.resource.data.at == request.time;
      allow read: if isVimoTeam();
      allow delete: if false;
    }

    // One thread per person with the VIMO Team.
    match /vimo_support/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isVimoTeam();
      allow create, update: if ((signedIn() && request.auth.uid == uid) || isVimoTeam())
        && request.resource.data.keys().hasOnly(['name', 'lastText', 'lastFrom', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 2000
        && request.resource.data.lastFrom == (request.auth.uid == uid ? 'user' : 'team')
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if (signedIn() && request.auth.uid == uid) || isVimoTeam();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'senderUid', 'text', 'reportId', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && ((request.auth.uid == uid && request.resource.data.from == 'user')
            || (isVimoTeam() && request.resource.data.from == 'team'))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.reportId is string && request.resource.data.reportId.size() <= 60
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // What the team decided about an account. Its owner can read it.
    match /vimo_sanctions/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isVimoTeam();
      allow create, update: if isVimoTeam()
        && request.resource.data.keys().hasOnly(['market', 'warnings', 'reason', 'by', 'updatedAt'])
        && request.resource.data.market in ['ok', 'blocked']
        && request.resource.data.warnings is int && request.resource.data.warnings >= 0
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500
        && request.resource.data.by == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
